{#- Pounce server startup banner.

    Uses milo component primitives for consistent styling.

    Receives:
        version            -- pounce version string
        gil                -- "nogil" or "GIL"
        url                -- full URL (e.g. "http://127.0.0.1:8000")
        uds                -- unix domain socket path or None
        workers            -- effective worker count (int)
        mode               -- worker mode label (e.g. "threads", "single")
        log_level          -- log level string
        features           -- list of {name, on, detail} dicts
        hints              -- list of hint strings
        health_check_path  -- health check path or ""
        root_path          -- root path or ""
        signage            -- "full" or "minimal" (off is handled before render)
        app_name           -- optional application name or ""
        app_tagline        -- optional tagline or ""
        app_version_str    -- e.g. "v1.0.0" or ""
        app_lines          -- extra lines under the app block (list of str)
        minimal_server_line -- one-line summary for minimal mode
-#}
{% from "components/_defs.kida" import header_box, kv_pair, status_line %}
{%- if signage == "minimal" -%}
{%- if app_name -%}
{{ header_box(app_name, app_version_str, app_tagline) }}
{%- for line in app_lines %}
  {{ line | dim }}
{%- endfor %}

{%- endif -%}
{{ minimal_server_line | dim }}
{%- else -%}
{%- if app_name -%}
{{ header_box(app_name, app_version_str, app_tagline) }}
{%- for line in app_lines %}
  {{ line | dim }}
{%- endfor %}

{%- endif -%}
{{ header_box("=^..^=  pounce", "v" ~ version, "ASGI server for Python 3.14t · " ~ gil) }}

{%- if uds %}
  {{ kv_pair("Socket", uds) }}
{%- else %}
  {{ "  " ~ icons.arrow_r | cyan }} {{ url | bold }}
{%- endif %}
  {{ kv_pair("Workers", workers | string ~ " " ~ mode) }}
  {{ kv_pair("Log level", log_level) }}
{%- for f in features %}
{%- if f.detail %}
  {{ kv_pair(f.name, f.detail) }}
{%- elif f.on %}
  {{ kv_pair(f.name, "on") }}
{%- else %}
  {{ kv_pair(f.name, "off") }}
{%- endif %}
{%- endfor %}
{%- if health_check_path %}
  {{ kv_pair("Health", health_check_path) }}
{%- endif %}
{%- if root_path %}
  {{ kv_pair("Root path", root_path) }}
{%- endif %}

{%- if hints %}

{%- for h in hints %}
  {{ status_line("info", h) }}
{%- endfor %}
{%- endif %}
{%- endif -%}