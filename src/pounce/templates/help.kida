{#- Pounce branded help output.

    Uses milo component primitives for consistent styling.

    Receives:
        state.prog         -- program name
        state.description  -- one-line description
        state.commands     -- root/group command metadata
        state.options      -- root-option metadata
        state.groups       -- leaf-command option groups
-#}
{% from "components/_defs.kida" import header_box, section, command_row, example_block %}
{%- set desc = state.description if state.description else "A free-threading-native ASGI server for Python 3.14t" -%}
{{ header_box("=^..^=  " ~ state.prog, "", desc) }}

{#- Show usage example for the serve subcommand -#}
{%- if "serve" in state.prog %}

{{ example_block([
  {"description": "Start a server", "command": state.prog ~ " --app myapp:app"},
  {"description": "Custom host and port", "command": state.prog ~ " --app myapp:app --host 0.0.0.0 --port 9000"},
  {"description": "Multi-worker with reload", "command": state.prog ~ " --app myapp:app --workers 4 --reload"},
]) }}
{%- elif state.prog == "pounce" %}

{{ example_block([
  {"description": "Start a server", "command": "pounce serve --app myapp:app"},
]) }}
{%- endif %}

{%- if state.commands %}
{{ section("Commands") }}
{% for cmd in state.commands %}{{ command_row(cmd.name, cmd.help) }}
{% endfor %}
{%- endif -%}

{%- if state.options %}
{{ section("Options") }}
{% for opt in state.options %}  {{ opt.flags | green }}{% if opt.metavar %} {{ opt.metavar | dim }}{% endif %}    {{ opt.help }}{% if opt.default is not none and opt.default != "" and opt.default != false and opt.default != 0 %} {{ ("(" ~ opt.default ~ ")") | dim }}{% endif %}
{% endfor %}
{%- endif %}

{% for group in state.groups -%}
{{ section(group.title) }}
{% for action in group.actions %}  {% if action.option_strings %}{{ action.option_strings | join(", ") | green }}{% else %}{{ action.dest | cyan }}{% endif %}{% if action.metavar %} {{ action.metavar | dim }}{% endif %}    {{ action.help }}{% if action.default is not none and action.default != "==SUPPRESS==" and action.default != "" and action.default != false %} {{ ("(" ~ action.default ~ ")") | dim }}{% endif %}
{% endfor %}
{%- endfor %}
{%- if state.epilog %}
{{ section("Configuration") }}
  {{ state.epilog | dim }}
{%- endif %}
